setup1.SendCommand(Command="/views/camera/target 2470 5700 0")
setup1.SendCommand(Command="/views/camera/position 2470 5700 5000")
setup1.SendCommand(Command="/views/camera/field 1300 1300")
setup1.SendCommand(Command="/views/camera/target 2520 5700 0")
setup1.SendCommand(Command="/views/camera/position 2520 5700 5000")
setup1.SendCommand(Command="/views/camera/field 750 750")
setup1.SendCommand(Command="/display/contour turb-kinetic-energy 0 0.03")
